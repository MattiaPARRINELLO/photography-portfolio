# BEGIN hardening-mprnl (2026-11-03)
# Blocage des fichiers sensibles. Source: ~/backups/hardening.block
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Repertoires de versioning
  RewriteRule (^|/)\.(git|svn|hg|bzr)(/|$) - [F,L]
  # Fichiers d'environnement et secrets
  RewriteRule (^|/)\.env($|\.) - [F,L]
  RewriteRule (^|/)\.(htpasswd|htaccess|user\.ini|bash_history|git-credentials|netrc|npmrc)$ - [F,L]
  RewriteRule (^|/)(id_rsa|id_ed25519|deploy_key)(\.pub)?$ - [F,L]
  # Manifests et code serveur
  RewriteRule (^|/)(package|package-lock|composer)\.(json|lock)$ - [F,L]
  RewriteRule (^|/)(server|app)\.js$ - [F,L]
  # Sauvegardes, dumps, cles, archives, docs internes
  # Exception : llms-full.md est un fichier public (contexte pour les agents IA).
  RewriteCond %{REQUEST_URI} !^/llms-full\.md$
  RewriteRule \.(sql|db|sqlite3?|bak|old|orig|save|swp|swo|log|ini|pem|key|crt|p12|pfx|zip|tar|gz|tgz|bz2|xz|7z|rar|phar|sh|md)$ - [F,L]
</IfModule>
<IfModule mod_authz_core.c>
  <FilesMatch "^(?!llms-full\.md$)(^\.env|^\.git|^\.svn|^(id_rsa|id_ed25519|deploy_key)(\.pub)?$|^(package|package-lock|composer)\.(json|lock)$|^(server|app)\.js$|\.(sql|db|bak|old|log|ini|pem|key|crt|p12|pfx|zip|tar|gz|phar|sh|md)$)">
    Require all denied
  </FilesMatch>
</IfModule>
# END hardening-mprnl
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/mattiapa/photo.mprnl.fr"
PassengerBaseURI "/"
PassengerNodejs "/home/mattiapa/nodevenv/photo.mprnl.fr/20/bin/node"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END


# =============================================================
# SÉCURITÉ : Passenger sert la racine du projet en statique.
# Sans ces règles, /.env, /config/*.json, /AGENTS.md sont
# téléchargeables en clair. Garde-fou équivalent dans server.js
# (middleware de refus) — les deux couches sont nécessaires.
#
# Ne PAS utiliser <LocationMatch> ici : le vhost n'autorise pas
# `Require` dans un <Location> coming d'un .htaccess → Apache renvoie
# 500 sur TOUTES les requêtes. /.well-known/ n'a pas besoin d'exemption :
# FilesMatch ne teste que le basename du fichier servi.
# =============================================================

# 1) Tout fichier caché (.env, .env.*, .npmrc, .htpasswd...)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 2) Dossiers internes du projet
RedirectMatch 404 ^/(?:config|logs|coverage|temp|scripts|tests|server|graphify-out|node_modules|data)/

# 3) Fichiers internes à la racine du projet
RedirectMatch 404 ^/(?:package|package-lock)\.json$
RedirectMatch 404 ^/(?:AGENTS|AUDIT|REFACTORING_PLAN|REFACTORING_STATUS|TESTS_REPORT|CONFIG_README)\.md$
RedirectMatch 404 ^/.*/README\.md$

# 4) Photos : le dossier est servi par Passenger en statique AVANT Node.
#    Seules les vignettes (miniatures générées) et la route /photos/resize
#    doivent être accessibles ; les originaux et le cache `resized/` non.
RedirectMatch 404 ^/photos/(?!resize(?:\?|$)|thumbnails/).*\.(?:jpe?g|png|webp|gif)$

# php -- BEGIN cPanel-generated handler, do not edit
# Définissez le package « ea-php84 » comme langage de programmation « PHP » par défaut.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
