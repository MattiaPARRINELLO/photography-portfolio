# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/mattiapa/photo.mprnl.fr"
PassengerBaseURI "/"
PassengerNodejs "/home/mattiapa/nodevenv/photo.mprnl.fr/20/bin/node"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# php -- BEGIN cPanel-generated handler, do not edit
# Définissez le package « ea-php84 » comme langage de programmation « PHP » par défaut.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit


# =============================================================
# SÉCURITÉ : Passenger sert la racine du projet en statique.
# Sans ces règles, /.env, /config/*.json, /AGENTS.md sont
# téléchargeables en clair. Garde-fou équivalent dans server.js
# (middleware de refus) — les deux couches sont nécessaires.
#
# Ne PAS utiliser <LocationMatch> ici : le vhost n'autorise pas
# `Require` dans un <Location> coming d'un .htaccess → Apache renvoie
# 500 sur TOUTES les requêtes. /.well-known/ n'a pas besoin d'exemption :
# FilesMatch ne teste que le basename du fichier servi.
# =============================================================

# 1) Tout fichier caché (.env, .env.*, .npmrc, .htpasswd...)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 2) Dossiers internes du projet
RedirectMatch 404 ^/(?:config|logs|coverage|temp|scripts|tests|server|graphify-out|node_modules)/

# 3) Fichiers internes à la racine du projet
RedirectMatch 404 ^/(?:package|package-lock)\.json$
RedirectMatch 404 ^/(?:AGENTS|AUDIT|REFACTORING_PLAN|REFACTORING_STATUS|TESTS_REPORT|CONFIG_README)\.md$
RedirectMatch 404 ^/.*/README\.md$
