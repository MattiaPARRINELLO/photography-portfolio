# Configuration des variables d'environnement pour l'envoi d'e-mails
GMAIL_USER=votre_email@gmail.com
GMAIL_PASS=votre_mot_de_passe_application

# Mot de passe administrateur
ADMIN_PASSWORD=votre_mot_de_passe_admin

# Port du serveur
PORT=3000

# Secret de session Express (64 caractères aléatoires)
SESSION_SECRET=votre_secret_session_aleatoire_64_chars

# Sel HMAC pour le cookie d'administration
ADMIN_REMEMBER_SALT=votre_sel_admin_aleatoire

# Clé secrète pour le formulaire de contact (signature HMAC)
CONTACT_API_SECRET=votre_cle_api_contact

# Clé secrète pour la signature des URLs d'images HD
IMAGE_SECRET_KEY=votre_cle_image_secret_32_chars_min

# URL du site (pour les canonical, sitemap, etc.)
SITE_URL=https://www.photo.mprnl.fr

# Configuration SMTP (optionnel, utilise GMAIL_USER/GMAIL_PASS par défaut)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
